{
  "name": "@jad-block/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run rules && wxt",
    "dev:firefox": "bun run rules && wxt -b firefox",
    "build": "bun run rules && wxt build && wxt build -b firefox",
    "zip": "bun run rules && wxt zip && wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "rules": "bun ../../packages/filter-engine/scripts/build-rules.ts"
  },
  "devDependencies": {
    "@jad-block/fixtures": "workspace:*",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@jad-block/candidate-detector": "workspace:*",
    "@jad-block/classifier": "workspace:*",
    "@jad-block/decision-engine": "workspace:*",
    "@jad-block/feature-extractor": "workspace:*",
    "@jad-block/filter-engine": "workspace:*",
    "@jad-block/privacy": "workspace:*",
    "@jad-block/schemas": "workspace:*"
  }
}
